{
  "$id": "https://raw.githubusercontent.com/aayushman-tech/boardroom-logic-stories/main/schema/story.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Boardroom Logic story (schemaVersion 1)",
  "description": "The machine-readable contract between the Boardroom Logic app and every story file. The app validates stories against this schema before playing them. Additional structural rules (reachability, length, endings) are checked by tools/validate.js.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "subtitle",
    "publishDate",
    "difficulty",
    "tags",
    "reasoningSkills",
    "premise",
    "characters",
    "stats",
    "startScene",
    "scenes",
    "debriefTakeaways"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/definitions/slug" },
    "title": { "type": "string", "minLength": 3, "maxLength": 120 },
    "subtitle": { "type": "string", "minLength": 3, "maxLength": 200 },
    "publishDate": { "$ref": "#/definitions/date" },
    "difficulty": { "enum": ["easy", "medium", "hard"] },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": { "type": "string", "minLength": 2, "maxLength": 40 }
    },
    "reasoningSkills": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "$ref": "#/definitions/skill" }
    },
    "premise": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": { "type": "string", "minLength": 40 }
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "role", "emoji"],
        "properties": {
          "id": { "$ref": "#/definitions/slug" },
          "name": { "type": "string", "minLength": 2, "maxLength": 80 },
          "role": { "type": "string", "minLength": 2, "maxLength": 120 },
          "emoji": { "type": "string", "minLength": 1, "maxLength": 8 }
        }
      }
    },
    "stats": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "start", "format"],
        "properties": {
          "id": { "$ref": "#/definitions/slug" },
          "label": { "type": "string", "minLength": 1, "maxLength": 40 },
          "start": { "type": "number" },
          "min": { "type": "number", "nullable": true },
          "max": { "type": "number", "nullable": true },
          "format": { "enum": ["currency", "number", "percent", "rating"] },
          "failBelow": { "type": "number" },
          "failScene": { "$ref": "#/definitions/sceneId" }
        },
        "allOf": [
          {
            "if": { "required": ["failBelow"] },
            "then": { "required": ["failScene"] }
          }
        ]
      }
    },
    "startScene": { "$ref": "#/definitions/sceneId" },
    "scenes": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": { "$ref": "#/definitions/scene" }
    },
    "debriefTakeaways": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": { "type": "string", "minLength": 20, "maxLength": 400 }
    }
  },
  "definitions": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,99}$"
    },
    "sceneId": { "$ref": "#/definitions/slug" },
    "skill": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "arrival", "narration"],
      "properties": {
        "chapter": { "type": "string", "minLength": 1, "maxLength": 80 },
        "title": { "type": "string", "minLength": 3, "maxLength": 120 },
        "arrival": { "$ref": "#/definitions/arrival" },
        "exhibits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/definitions/exhibit" }
        },
        "narration": { "type": "string", "minLength": 20 },
        "addNotes": {
          "type": "array",
          "maxItems": 4,
          "items": { "type": "string", "minLength": 5 }
        },
        "choices": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/definitions/choice" }
        },
        "ending": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/ending" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "required": ["ending"], "properties": { "ending": { "type": "object" } } },
          "then": { "required": ["ending"], "not": { "required": ["choices"] } }
        },
        {
          "if": { "not": { "required": ["ending"], "properties": { "ending": { "type": "object" } } } },
          "then": { "required": ["choices"], "properties": { "choices": { "minItems": 1 } } }
        }
      ]
    },
    "arrival": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "body"],
      "properties": {
        "type": {
          "enum": [
            "email",
            "memo",
            "phone_call",
            "chart",
            "news_alert",
            "visitor",
            "chat_message",
            "contract",
            "report"
          ]
        },
        "from": { "type": "string", "minLength": 1, "maxLength": 120 },
        "subject": { "type": "string", "minLength": 1, "maxLength": 160 },
        "body": { "type": "string", "minLength": 1 },
        "icon": { "type": "string", "minLength": 1, "maxLength": 8 }
      }
    },
    "exhibit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title"],
      "properties": {
        "type": { "enum": ["table", "bar_chart", "line_chart", "kpi"] },
        "title": { "type": "string", "minLength": 3, "maxLength": 120 },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 40 }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": { "type": "string", "minLength": 1, "maxLength": 60 }
          }
        },
        "unit": { "type": "string", "maxLength": 12 },
        "data": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "value"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 40 },
              "value": { "type": "number" }
            }
          }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "value"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 60 },
              "value": { "type": "string", "minLength": 1, "maxLength": 40 },
              "delta": { "type": "string", "maxLength": 40 }
            }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "table" } } }, "then": { "required": ["columns", "rows", "type"] } },
        { "if": { "properties": { "type": { "const": "bar_chart" } } }, "then": { "required": ["data", "type"] } },
        { "if": { "properties": { "type": { "const": "line_chart" } } }, "then": { "required": ["data", "type"] } },
        { "if": { "properties": { "type": { "const": "kpi" } } }, "then": { "required": ["items", "type"] } }
      ]
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "feedback", "next"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 40 },
        "text": { "type": "string", "minLength": 1, "maxLength": 300 },
        "requireFlags": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/definitions/slug" }
        },
        "hideIfFlags": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/definitions/slug" }
        },
        "requireStats": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 4,
          "additionalProperties": { "$ref": "#/definitions/statCondition" }
        },
        "effects": {
          "type": "object",
          "maxProperties": 6,
          "additionalProperties": { "type": "number" }
        },
        "setFlags": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/definitions/slug" }
        },
        "clearFlags": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/definitions/slug" }
        },
        "logic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["quality", "why"],
          "properties": {
            "quality": { "type": "integer", "minimum": -2, "maximum": 2 },
            "skill": { "$ref": "#/definitions/skill" },
            "why": { "type": "string", "minLength": 30, "maxLength": 500 }
          }
        },
        "feedback": { "type": "string", "minLength": 5, "maxLength": 400 },
        "next": { "$ref": "#/definitions/sceneId" }
      }
    },
    "statCondition": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "gte": { "type": "number" },
        "lte": { "type": "number" },
        "gt": { "type": "number" },
        "lt": { "type": "number" }
      }
    },
    "ending": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title", "summary"],
      "properties": {
        "kind": { "enum": ["triumph", "solid", "mixed", "failure"] },
        "title": { "type": "string", "minLength": 3, "maxLength": 120 },
        "summary": { "type": "string", "minLength": 40, "maxLength": 1200 }
      }
    }
  }
}
