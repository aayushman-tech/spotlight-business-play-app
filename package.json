{
  "name": "spotlight-business",
  "productName": "Spotlight Business",
  "version": "1.2.0",
  "description": "A 90s-style choose-your-path business adventure game. Read the scene, make the call, build an empire or face game over.",
  "author": "Spotlight-Aayushman",
  "license": "MIT",
  "main": "src/main/main.js",
  "type": "commonjs",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/aayushman-tech/spotlight-business-play-app.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/engine.test.mjs",
    "test:smoke": "node --test tests/electron-smoke.test.mjs",
    "make-icons": "node tools/make-icons.js",
    "build:exe": "electron-builder --win nsis",
    "build:store": "node scripts/build-store-package.js",
    "dist": "npm run build:exe && npm run build:store",
    "screenshots": "node scripts/take-screenshots.mjs"
  },
  "build": {
    "appId": "com.spotlightbusiness.app",
    "productName": "Spotlight Business",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "SpotlightBusiness-Setup-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Spotlight Business"
    },
    "publish": null
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "playwright": "^1.48.0"
  },
  "engines": {
    "node": ">=20"
  }
}
