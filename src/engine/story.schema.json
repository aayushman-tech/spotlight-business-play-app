{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Spotlight Business Play Story v2",
  "description": "Schema for choose-your-path business adventure stories in Spotlight Business Play.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "subtitle",
    "publishDate",
    "tags",
    "premise",
    "characters",
    "startScene",
    "scenes",
    "lessons"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 60
    },
    "subtitle": {
      "type": "string",
      "minLength": 5,
      "maxLength": 100
    },
    "publishDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "premise": {
      "type": "string",
      "minLength": 20
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "role", "emoji"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "role": { "type": "string" },
          "emoji": { "type": "string" }
        }
      }
    },
    "startScene": {
      "type": "string"
    },
    "scenes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["title", "narration"],
        "additionalProperties": false,
        "properties": {
          "chapter": { "type": "string" },
          "title": { "type": "string", "minLength": 2 },
          "arrival": {
            "type": "object",
            "required": ["type", "body"],
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "email",
                  "memo",
                  "phone_call",
                  "chart",
                  "news_alert",
                  "visitor",
                  "chat_message",
                  "contract",
                  "report",
                  "newspaper"
                ]
              },
              "from": { "type": "string" },
              "subject": { "type": "string" },
              "body": { "type": "string" },
              "icon": { "type": "string" }
            }
          },
          "exhibits": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "title"],
              "additionalProperties": true,
              "properties": {
                "type": { "enum": ["table", "bar_chart", "line_chart", "kpi"] },
                "title": { "type": "string" },
                "columns": { "type": "array", "items": { "type": "string" } },
                "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } },
                "data": { "type": "array" },
                "items": { "type": "array" }
              }
            }
          },
          "narration": {
            "type": "string"
          },
          "choices": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["id", "text", "next"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "text": { "type": "string" },
                "requireFlags": { "type": "array", "items": { "type": "string" } },
                "hideIfFlags": { "type": "array", "items": { "type": "string" } },
                "setFlags": { "type": "array", "items": { "type": "string" } },
                "clearFlags": { "type": "array", "items": { "type": "string" } },
                "next": { "type": "string" }
              }
            }
          },
          "ending": {
            "type": "object",
            "required": ["kind", "title", "summary"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["win", "lose"] },
              "title": { "type": "string" },
              "summary": { "type": "string" },
              "reason": { "type": "string" },
              "lesson": { "type": "string" }
            }
          }
        }
      }
    },
    "lessons": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": { "type": "string" }
    }
  }
}
